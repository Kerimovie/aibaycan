{
  "name": "aibaycan.az",
  "version": "0.0.0",
  "private": true,
  "description": "Portfolio saytı — gördüyümüz işlər və təklif etdiyimiz xidmətlər",
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "pnpm --parallel --recursive run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\"",
    "test:e2e": "pnpm --filter @aibaycan/e2e test"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
