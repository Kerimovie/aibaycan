// aibaycan.az — Prisma schema
// Prisma 7: generator "prisma-client" + məcburi output + driver adapter (@prisma/adapter-pg)
// Data model əsaslandırması: docs/07-data-model.md, docs/28-module-map.md (Faza 1)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL artıq burada deyil.
  // CLI/migrate üçün prisma.config.ts-də, runtime üçün adapter-də (src/client.ts).
}

// ============================================================================
// MEDIA — mərkəzi media kitabxanası (Cloudflare R2, bax docs/09 #011)
// ============================================================================

/// Yüklənmiş media faylları — R2-də saxlanır, DB-də yalnız URL + metadata
model MediaAsset {
  id        String         @id @default(cuid())
  url       String // R2 public URL
  key       String         @unique // R2 obyekt açarı (silmə üçün)
  type      MediaType      @default(IMAGE)
  mimeType  String
  fileName  String
  alt       String? // əlçatanlıq / SEO
  width     Int?
  height    Int?
  sizeBytes Int
  createdAt DateTime       @default(now())

  // Geri-əlaqələr (bu asset harada istifadə olunur)
  coverForCaseStudies CaseStudy[] @relation("CaseStudyCover")

  @@index([type, createdAt])
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

// ============================================================================
// TAXONOMY — Category + Tag (CaseStudy + gələcək Post üçün ortaq, docs/09 #012)
// ============================================================================

/// Kateqoriyalar (case-study təsnifatı, filtr)
model Category {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String?
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  caseStudies CaseStudy[] @relation("CaseStudyCategories")

  @@index([order])
}

/// Sərbəst teqlər (filtr)
model Tag {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  createdAt   DateTime    @default(now())

  caseStudies CaseStudy[] @relation("CaseStudyTags")
}

// ============================================================================
// WORK — CaseStudy (block-based content, docs/09 #010)
// ============================================================================

/// Görülən işlər / case-study-lər — portfolio + lead-gen-in əsası
model CaseStudy {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  tagline     String? // qısa alt-başlıq
  summary     String // listing üçün qısa təsvir
  clientName  String?
  projectYear Int?

  // Block-based kontent (JSON — richText/image/gallery/video/quote/metrics/twoColumn)
  // Struktur Zod ilə validasiya olunur (packages/shared), bax docs/28.
  blocks      Json         @default("[]")

  // Media
  coverImageId String?
  coverImage   MediaAsset? @relation("CaseStudyCover", fields: [coverImageId], references: [id], onDelete: SetNull)

  // Xarici linklər
  liveUrl String?
  repoUrl String?

  // Görünürlük / sıralama
  featured  Boolean @default(false)
  published Boolean @default(false)
  order     Int     @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?

  // Əlaqələr (many-to-many)
  categories Category[] @relation("CaseStudyCategories")
  tags       Tag[]      @relation("CaseStudyTags")
  services   Service[]  @relation("ServiceCaseStudies")

  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, featured])
  @@index([order])
}

// ============================================================================
// SERVICES — təklif olunan xidmətlər (↔ CaseStudy cross-link)
// ============================================================================

/// Təklif etdiyimiz xidmətlər
model Service {
  id          String      @id @default(cuid())
  slug        String      @unique
  title       String
  description String
  icon        String?
  published   Boolean     @default(false)
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // "Bu xidmətə uyğun işlərimiz" cross-link
  caseStudies CaseStudy[] @relation("ServiceCaseStudies")

  @@index([published])
  @@index([order])
}

// ============================================================================
// LEAD — müştəri sorğuları (zəngin + mini-CRM, ContactMessage-i əvəz edir)
// ============================================================================

/// Saytdan gələn müştəri sorğuları (lead-gen)
model Lead {
  id      String  @id @default(cuid())
  name    String
  email   String
  phone   String?
  company String?

  // Kontekst
  interestedIn String? // maraqlandığı xidmət(lər)
  budgetRange  String?
  message      String

  // Mənbə (marketinq atributu)
  source   String? // UTM / referrer
  pageUrl  String? // hansı səhifədən gəldi

  // Mini-CRM status
  status LeadStatus @default(NEW)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

// ============================================================================
// AUTH — admin panel istifadəçiləri (single-tenant, bax docs/03)
// ============================================================================

/// Admin panel istifadəçiləri (tenantId yoxdur — single-tenant)
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
  EDITOR
}
