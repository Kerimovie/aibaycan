// aibaycan.az — Prisma schema
// Prisma 7: generator "prisma-client" + məcburi output + driver adapter (@prisma/adapter-pg)
// Data model əsaslandırması: docs/07-data-model.md

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: connection URL artıq burada deyil.
  // CLI/migrate üçün prisma.config.ts-də, runtime üçün adapter-də (src/client.ts).
}

/// Görülən işlər / case-study-lər — portfolio-nun əsası
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  coverImage  String?
  images      String[] @default([])
  techStack   String[] @default([])
  liveUrl     String?
  repoUrl     String?
  featured    Boolean  @default(false)
  published   Boolean  @default(false)
  order       Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, featured])
  @@index([order])
}

/// Təklif etdiyimiz xidmətlər
model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  icon        String?
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published])
  @@index([order])
}

/// Əlaqə formundan gələn mesajlar
model ContactMessage {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())

  @@index([status, createdAt])
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

/// Admin panel istifadəçiləri (single-tenant — tenantId yoxdur, bax docs/03)
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
  EDITOR
}
