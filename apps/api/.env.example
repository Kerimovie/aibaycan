NODE_ENV=development
PORT=7302

# packages/db ilə eyni Postgres bağlantısı
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/aibaycan?schema=public"

# JWT imza açarı — ən azı 32 simvol. Production-da güclü random dəyər istifadə et:
#   openssl rand -base64 48
JWT_SECRET="dev-only-change-me-min-32-chars-long-secret"

# CORS icazəli origin-lər (web + admin frontend)
CORS_ORIGINS="http://localhost:7301,http://localhost:7303"

# Cloudflare R2 (media upload) — opsional. Yoxdursa upload işləməz, server qalxar.
# Cloudflare dashboard → R2 → bucket + API token (S3-uyğun credentials)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="aibaycan-media"
# Bucket-in ictimai baza URL-i (custom domain və ya r2.dev)
R2_PUBLIC_URL="https://media.aibaycan.az"

# Lead email bildirişi (Resend) — opsional. Yoxdursa email göndərilmir, lead yenə yazılır.
# https://resend.com → API key + təsdiqlənmiş domen
RESEND_API_KEY=""
LEAD_NOTIFY_FROM="noreply@aibaycan.az"
# Vergüllə ayrılmış alıcılar
LEAD_NOTIFY_TO="info@aibaycan.az"

# Rate-limit söndürmə açarı — YALNIZ test/E2E üçün. Prod/dev-də TƏYİN ETMƏ (default aktiv).
# "true" olsa login + lead rate-limit tamamilə söndürülür (docs/16).
# RATE_LIMIT_DISABLED="true"
