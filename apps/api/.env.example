NODE_ENV=development
PORT=3001

# packages/db ilə eyni Postgres bağlantısı
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/aibaycan?schema=public"

# JWT imza açarı — ən azı 32 simvol. Production-da güclü random dəyər istifadə et:
#   openssl rand -base64 48
JWT_SECRET="dev-only-change-me-min-32-chars-long-secret"

# CORS icazəli origin-lər (web + admin frontend)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
