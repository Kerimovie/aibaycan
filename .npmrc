# Yalnız birbaşa asılılıqlara icazə ver — phantom (təsadüfi) asılılıqların qarşısını alır
strict-peer-dependencies=false
auto-install-peers=true

# Workspace paketləri həmişə lokal link olunsun (registry-dən yox)
link-workspace-packages=true
prefer-workspace-packages=true

# Deterministik quraşdırma — lockfile olmadan CI uğursuz olsun
# (CI-də `pnpm install --frozen-lockfile` istifadə et)
